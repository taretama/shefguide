# Copy this file to .env and fill in real values.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored and must stay that way. Never commit real keys:
# a secret pushed to a public repository has to be treated as compromised
# from that moment, and rotating it afterwards is the only fix.

# MongoDB connection string.
# Local development:  mongodb://localhost:27017
# Atlas:              mongodb+srv://USER:PASSWORD@cluster.mongodb.net/shefguide
MONGO_URI=mongodb://localhost:27017

# OpenAI, for GPT-4o-mini. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-put-your-key-here

# Google AI Studio, for Gemini 3.5 Flash. https://aistudio.google.com/apikey
# Note the free tier allows 20 requests per project per model per day, which
# is the constraint the evaluation in Chapter 5 was collected under.
GEMINI_API_KEY=put-your-key-here

# Signing key for session tokens. Generate a fresh random one per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone holding this value can forge a login for any account, so it must not
# be shared between environments or checked in.
JWT_SECRET=generate-a-random-value-do-not-reuse-this-string

# Comma-separated origins allowed to call the API. Defaults to localhost if
# unset; set it explicitly in any deployment that is not local.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
